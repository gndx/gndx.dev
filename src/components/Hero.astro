---
import config from '@config/config.json';
import social from '@config/social';

export interface SocialMedia {
  icon: string;
  url: string;
  svg: string;
}

interface Props {
  socialItems?: SocialMedia[];
  isPrimaryHeading?: boolean;
}

const { isPrimaryHeading = false } = Astro.props as Props;

const socialItems = social.networks.map((item) => ({
  ...item,
  // Keep SVG labels out of the document title collection. The link itself
  // provides the accessible name, while the decorative icon stays hidden.
  svg: item.svg
    .replace(/<title>.*?<\/title>/g, '')
    .replace('<svg ', '<svg aria-hidden="true" focusable="false" ')
}));
const hashtags = (config.author.bio.match(/#[\p{L}\p{N}_-]+/gu) ?? []).filter(
  (tag) => tag.toLowerCase() !== '#withastro'
);
const bioMain = config.author.bio
  .replace(/#[\p{L}\p{N}_-]+/gu, '')
  .replace(/-\s*-/g, '-')
  .replace(/\s{2,}/g, ' ')
  .trim();
---

<section class='nd-hero'>
  <div class='mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8' style='padding-top: 32px; padding-bottom: 48px;'>
    <div class='flex items-start justify-between gap-8'>
      <div class='flex-1 min-w-0'>
        {
          isPrimaryHeading
            ? <h1 class='nd-hero-name'>{config.author.name}</h1>
            : <p class='nd-hero-name'>{config.author.name}</p>
        }
        <p class='nd-hero-bio'>{bioMain}</p>
        {
          hashtags.length > 0 && (
            <p class='nd-hero-tags'>{hashtags.join(' ')}</p>
          )
        }
        <div class='nd-social-row'>
          {
            socialItems?.map((item) => (
              <a
                href={item.url}
                target='_blank'
                rel='noopener noreferrer'
                class='nd-social-icon'
                aria-label={item.name}
              >
                <figure>
                  <Fragment set:html={item.svg} />
                </figure>
              </a>
            ))
          }
        </div>
      </div>

      <div class='flex-shrink-0 self-stretch'>
        <figure class='nd-avatar-figure'>
          <img
            class='nd-avatar'
            width={540}
            height={820}
            src={config.author.avatar}
            alt={config.author.name}
            decoding='async'
            loading='eager'
            fetchpriority='high'
          />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .nd-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--nd-border);
  }

  /* Nothing dot-grid motif — fades at the bottom */
  .nd-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, var(--nd-border-visible) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 100%);
  }

  .nd-hero > * {
    position: relative;
    z-index: 1;
  }

  .nd-hero-name {
    font-family: var(--font-space-grotesk);
    font-size: clamp(2rem, 3.5vw + 0.5rem, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--nd-text-display);
    margin: 0 0 8px 0;
    line-height: 1.1;
  }

  .nd-hero-bio {
    margin: 0 0 8px 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--nd-text-secondary);
    max-width: 75%;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nd-hero-tags {
    margin: 0 0 24px 0;
    font-family: var(--font-space-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--nd-warning);
    opacity: 0.75;
  }

  .nd-social-row {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .nd-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--nd-border-visible);
    border-radius: 8px;
    color: var(--nd-text-secondary);
    transition: color 200ms ease, border-color 200ms ease;
  }

  .nd-social-icon:hover {
    color: var(--nd-warning);
    border-color: var(--nd-warning);
  }

  .nd-social-icon :global(svg) {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Retrato recortado (fondo transparente) como en mentor.gndx.dev.
     Posicionado en absoluto para no estirar el hero: los offsets top/bottom
     cancelan el padding del contenedor (32px/48px), así la imagen abarca
     exactamente la altura del hero — del borde del header a la línea
     inferior — y la altura de la sección la sigue dictando el texto. */
  .nd-avatar-figure {
    position: relative;
    height: 100%;
    width: 140px;
    margin: 0;
  }

  .nd-avatar {
    position: absolute;
    bottom: -48px;
    right: 0;
    /* 100% = alto de la fila; +80px cubre los paddings (32 arriba + 48 abajo)
       para que el retrato abarque la altura completa del hero. */
    height: calc(100% + 80px);
    width: auto;
    max-width: none;
  }

  @media (min-width: 640px) {
    .nd-avatar-figure {
      width: 200px;
    }
  }
</style>
