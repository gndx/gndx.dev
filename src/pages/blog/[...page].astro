---
import Base from "@layouts/Base.astro";
import Posts from "@layouts/Posts.astro";
import Pagination from "@components/Pagination.astro";

import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection("blogEs");
  const formattedPosts = allPosts
    .map((post) => ({ ...post, slug: post.slug || post.id.replace(/\.(md|mdx)$/i, '') }))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(formattedPosts, {
    pageSize: 9,
  });
}
const { page } = Astro.props;
const pageTitle = page.currentPage === 1
  ? 'Blog de JavaScript, React e IA | GNDX'
  : `Blog de JavaScript, React e IA — Página ${page.currentPage} | GNDX`;
const pageDescription = page.currentPage === 1
  ? 'Artículos y tutoriales de Oscar Barajas sobre JavaScript, React, inteligencia artificial, agentes de IA, desarrollo web y carrera profesional.'
  : `Página ${page.currentPage} del blog de Oscar Barajas sobre desarrollo web, JavaScript, React e inteligencia artificial.`;
---

<Base
  meta_title={pageTitle}
  description={pageDescription}
  paginationPrev={page.url.prev}
  paginationNext={page.url.next}
>
  <h1 class="text-2xl md:text-3xl font-bold mb-8">Blog</h1>
  <Posts posts={page.data} />
  <Pagination
    length={page.lastPage}
    currentUrl={page.url.current}
    currentPage={page.currentPage}
    firstUrl={`/blog/`}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    lastUrl={`/blog/${page.lastPage}`}
  />
</Base>
