---
import Base from "@layouts/Base.astro";
import TaxonomyPosts from "@components/TaxonomyPosts.astro";

import { getTaxonomy } from "@utils/getAllTags";
import { getSinglePage } from "@utils/getAllTags";
import { taxonomyFilter } from "@utils/getAllTags";
import { deslugify } from "@utils/slug";

export async function getStaticPaths() {
  const categories = await getTaxonomy("blogEs", "categories");

  return categories.map((category) => {
    return {
      params: { category: category.slug },
    };
  });
}

const { category } = Astro.params;

const posts = await getSinglePage("blogEs");
const filterByCategory = taxonomyFilter(posts, "categories", category);
const term = deslugify(category as string);
---

<Base
  meta_title={`Artículos de ${term} | GNDX`}
  description={`Artículos y tutoriales de Oscar Barajas sobre ${term}, desarrollo web, JavaScript e inteligencia artificial.`}
  includeHreflang={false}
>
  <TaxonomyPosts
    posts={filterByCategory}
    term={term}
    prefixLabel="Categoria"
    subtitle="Ver posts con la categoria"
    locale="es"
  />
</Base>
