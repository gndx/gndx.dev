---
import Base from '@layouts/Base.astro';
import CategoryIcon from '@icons/CategoryIcon.astro';
import { getTaxonomyByLocale } from '@utils/i18nContent';
import { prefixedLocales, isLocale, withLocalePath } from '@i18n/config';
import { getUi } from '@i18n/ui';

export async function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.redirect('/');

const copy = getUi(locale);
const categories = await getTaxonomyByLocale(locale, 'categories');
const metadata = {
  en: { title: 'Blog Categories | GNDX', description: 'Explore GNDX articles by category: JavaScript, React, artificial intelligence, AI agents, web development and technology.' },
  pt: { title: 'Categorias do blog | GNDX', description: 'Explore os artigos da GNDX por categoria: JavaScript, React, inteligência artificial, agentes de IA e desenvolvimento web.' },
  es: { title: 'Categorías del blog | GNDX', description: 'Explora los artículos de GNDX por categorías: JavaScript, React, inteligencia artificial, agentes y desarrollo web.' }
}[locale];
---

<Base locale={locale} meta_title={metadata.title} description={metadata.description}>
  <section class='grid grid-cols-1'>
    <h1 class='text-2xl md:text-3xl font-bold mb-8'>{copy.labels.categories}:</h1>
    <ul class='flex flex-wrap gap-3 text-gray-500'>
      {
        categories.map((category) => (
          <li class='flex items-center justify-between mr-4'>
            <CategoryIcon />
            <a
              class='text-lg text-gray-500 hover:text-gray-800 capitalize'
              href={withLocalePath(locale, `/categories/${category.slug}`)}
              title={`${copy.labels.postsWithCategory}: ${category.name}`}
            >
              {category.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
