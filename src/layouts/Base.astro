---
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import FeaturedVideos from '@components/FeaturedVideos.astro';
import Footer from '@components/Footer.astro';
import config from '@config/config.json';
import social from '@config/social';
import { locales, type Locale, stripLocaleFromPath, withLocalePath } from '@i18n/config';
import { truncateSeoText } from '@utils/seo';

import '@styles/global.css';

import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

export interface Props {
  title?: string;
  meta_title?: string;
  socialTitle?: string;
  description?: string;
  socialDescription?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  alternateUrls?: Partial<Record<Locale, string>>;
  includeHreflang?: boolean;
  paginationPrev?: string;
  paginationNext?: string;
  heroPrimaryHeading?: boolean;
  blogpost?: boolean;
  locale?: Locale;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
  imageAlt?: string;
}

const {
  title,
  meta_title,
  socialTitle,
  description,
  socialDescription,
  image,
  noindex,
  blogpost,
  canonical,
  alternateUrls,
  includeHreflang = true,
  paginationPrev,
  paginationNext,
  heroPrimaryHeading,
  locale = 'es',
  articlePublishedTime,
  articleModifiedTime,
  articleSection,
  articleTags,
  imageAlt
} = Astro.props as Props;

const defaultDescriptions: Record<Locale, string> = {
  es: config.metadata.meta_description,
  en: 'Software AI Engineer and tech educator specializing in JavaScript, React and AI. Platzi instructor, Microsoft MVP and content creator.',
  pt: 'Software AI Engineer e educador tech especializado em JavaScript, React e IA. Professor da Platzi, Microsoft MVP e criador de conteúdo.'
};
const rawPageTitle = meta_title || title || config.site.title;
const rawPageDescription = description || defaultDescriptions[locale];
const pageTitle = truncateSeoText(rawPageTitle, 60);
const pageDescription = truncateSeoText(rawPageDescription, 160);
const shareTitle = socialTitle || rawPageTitle;
const shareDescription = truncateSeoText(socialDescription || rawPageDescription, 200);
const ogImage = image || 'https://s3.us-east-1.amazonaws.com/gndx.dev/gndx_og.jpg';
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, config.site.base_url).toString();
const ogImageAlt = imageAlt || `${pageTitle} — ${config.author.name}`;
const ogImagePath = new URL(ogImageUrl).pathname.toLowerCase();
const ogImageType = ogImagePath.endsWith('.jpg') || ogImagePath.endsWith('.jpeg')
  ? 'image/jpeg'
  : ogImagePath.endsWith('.webp')
    ? 'image/webp'
    : 'image/png';
const canonicalUrl = canonical || new URL(Astro.url.pathname, config.site.base_url).toString();
const pathWithoutLocale = stripLocaleFromPath(Astro.url.pathname);
const alternateLinks = includeHreflang
  ? locales.flatMap((lang) => {
      const href = alternateUrls
        ? alternateUrls[lang]
        : new URL(withLocalePath(lang, pathWithoutLocale), config.site.base_url).toString();
      return href ? [{ lang, href }] : [];
    })
  : [];
const xDefaultUrl = alternateLinks.find((link) => link.lang === 'es')?.href;
const rssPath = locale === 'es' ? '/rss.xml' : `/${locale}/rss.xml`;
const jsonFeedPath = locale === 'es' ? '/feed.json' : `/${locale}/feed.json`;
const markdownPath = blogpost
  ? `${Astro.url.pathname.replace(/\/$/, '')}.md`
  : undefined;
const isDev = import.meta.env.DEV;
const robots = noindex
  ? 'noindex,follow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const ogLocaleMap: Record<Locale, string> = {
  es: 'es_ES',
  en: 'en_US',
  pt: 'pt_BR'
};
const ogLocale = ogLocaleMap[locale];
const alternateOgLocales = locales.filter((lang) => lang !== locale).map((lang) => ogLocaleMap[lang]);
const ogType = blogpost ? 'article' : 'website';
const personId = `${config.site.base_url}/#person`;
const websiteId = `${config.site.base_url}/#website`;
const isProfilePage = pathWithoutLocale === '/' || pathWithoutLocale === '/about/';
const websiteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${config.site.base_url}/`,
      name: config.site.name,
      alternateName: [config.site.title, 'gndx.dev'],
      description: defaultDescriptions[locale],
      inLanguage: locale,
      publisher: { '@id': personId }
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: config.author.name,
      alternateName: '@gndx',
      url: `${config.site.base_url}/`,
      image: new URL(config.author.avatar, config.site.base_url).toString(),
      jobTitle: 'Software AI Engineer',
      sameAs: social.networks.map((network) => network.url)
    },
    {
      '@type': isProfilePage ? 'ProfilePage' : 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: rawPageDescription,
      inLanguage: locale,
      isPartOf: { '@id': websiteId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl,
        width: 1200,
        height: 630
      },
      ...(isProfilePage ? { mainEntity: { '@id': personId } } : {})
    }
  ]
};
const serializedWebsiteLd = JSON.stringify(websiteLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale} data-theme='dark'>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' href='/favicon.svg' type='image/svg+xml' />
    <link rel='icon' href='/favicons/favicon-32x32.png' sizes='32x32' type='image/png' />
    <link rel='icon' href='/favicons/favicon-16x16.png' sizes='16x16' type='image/png' />
    <link rel='shortcut icon' href={config.site.favicon} type='image/png' />
    <link rel='apple-touch-icon' href='/favicons/apple-icon-180x180.png' sizes='180x180' />
    <meta name='theme-name' content='bookworm-light-astro' />
    <meta name='msapplication-TileColor' content='#000000' />
    <meta name='theme-color' content='#000000' />
    <meta name='generator' content={Astro.generator} />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    {/* Prevent flash of wrong theme — runs before CSS */}
    <script is:inline>
      (function () {
        try {
          var m = document.cookie.match(/(?:^|; )nd-theme=([^;]*)/);
          var t = m ? decodeURIComponent(m[1]) : null;
          if (!t) t = localStorage.getItem('nd-theme');
          if (t) {
            document.documentElement.setAttribute('data-theme', t);
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (_) {}
      })();
    </script>
    <Font cssVariable='--font-space-grotesk' preload={[{ weight: 400, subset: 'latin' }]} />
    <Font cssVariable='--font-space-mono' preload={[{ weight: 400, subset: 'latin' }]} />
    <Font cssVariable='--font-jetbrains-mono' />

    <title>{pageTitle}</title>
    <meta name='title' content={pageTitle} />
    <meta name='description' content={pageDescription} />
    <meta name='author' content={config.metadata.meta_author} />
    <meta name='robots' content={robots} />

    <link rel='canonical' href={canonicalUrl} item-prop='url' />
    {paginationPrev && <link rel='prev' href={new URL(paginationPrev, config.site.base_url).toString()} />}
    {paginationNext && <link rel='next' href={new URL(paginationNext, config.site.base_url).toString()} />}
    <link rel='author' href={new URL(withLocalePath(locale, '/about'), config.site.base_url).toString()} />
    {
      alternateLinks.map(({ lang, href }) => (
        <link
          rel='alternate'
          hreflang={lang}
          href={href}
        />
      ))
    }
    {xDefaultUrl && <link rel='alternate' hreflang='x-default' href={xDefaultUrl} />}
    <link rel='alternate' type='application/rss+xml' title={`${config.site.name} RSS (${locale})`} href={rssPath} />
    <link rel='alternate' type='application/feed+json' title={`${config.site.name} JSON Feed (${locale})`} href={jsonFeedPath} />
    <link rel='alternate' type='text/plain' title='GNDX content guide for AI agents' href='/llms.txt' />
    {markdownPath && <link rel='alternate' type='text/markdown' title={`${pageTitle} — Markdown`} href={markdownPath} />}

    <meta property='og:title' content={shareTitle} />
    <meta property='og:description' content={shareDescription} />
    <meta property='og:type' content={ogType} />
    <meta property='og:url' content={canonicalUrl} />
    <meta property='og:image' content={ogImageUrl} />
    <meta property='og:image:secure_url' content={ogImageUrl} />
    <meta property='og:image:type' content={ogImageType} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content={ogImageAlt} />
    <meta property='og:site_name' content={config.site.name} />
    <meta property='og:locale' content={ogLocale} />
    {alternateOgLocales.map((ogAltLocale) => <meta property='og:locale:alternate' content={ogAltLocale} />)}

    {blogpost && articlePublishedTime && (
      <meta property='article:published_time' content={articlePublishedTime} />
    )}
    {blogpost && articleModifiedTime && <meta property='article:modified_time' content={articleModifiedTime} />}
    {blogpost && articleSection && <meta property='article:section' content={articleSection} />}
    {blogpost && articleTags?.map((tag) => <meta property='article:tag' content={tag} />)}
    {blogpost && <meta property='article:author' content={new URL(withLocalePath(locale, '/about'), config.site.base_url).toString()} />}

    <meta name='twitter:title' content={shareTitle} />
    <meta name='twitter:description' content={shareDescription} />
    <meta name='twitter:image' content={ogImageUrl} />
    <meta name='twitter:image:alt' content={ogImageAlt} />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:site' content='@gndx' />
    <meta name='twitter:creator' content='@gndx' />

    <script type='application/ld+json' set:html={serializedWebsiteLd} />

    {
      isDev && (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then((registrations) => {
              registrations.forEach((registration) => registration.unregister());
            });
          }
        </script>
      )
    }
    {!isDev && <script is:inline src='/registerSW.js' defer></script>}
    {!isDev && <link rel='manifest' href='/manifest.webmanifest' />}
    <ClientRouter />
  </head>
  <body>
    {!blogpost && (
      <div style='border-bottom: 1px solid var(--nd-border); background: var(--nd-surface); padding: 10px 16px; border-left: 3px solid var(--nd-warning);'>
        <p style='text-align: center; font-size: 14px; font-weight: 500; letter-spacing: 0.01em;'>
          <a href='https://mentor.gndx.dev/' style='color: var(--nd-warning); transition: color 200ms ease;'>
            ¿Cómo Aprovechar al Máximo una Mentoría? →
          </a>
        </p>
      </div>
    )}
    <Header locale={locale} />
    {!blogpost && <Hero isPrimaryHeading={heroPrimaryHeading ?? pathWithoutLocale === '/'} />}
    <main class='mx-auto max-w-screen-xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8'>
      <slot />
    </main>
    {!blogpost && <FeaturedVideos />}
    <Footer />
    <script>
      // This is a hack to get vite-plugin-pwa to generate a sw.js file.
      // Do not remove this script tag.
    </script>
  </body>
</html>
